team:
  name: "研发团队"
  timezone: "Asia/Shanghai"

network:
  # Optional. Path to a PEM bundle used for TLS verification. Leave empty to use
  # certifi's default trust store. Set it when a local TLS-intercepting proxy
  # (e.g. Watt Toolkit / Steam++ "GitHub accelerator") rewrites the hosts file:
  # point it at a bundle concatenating certifi's cacert.pem with the proxy's CA.
  ca_bundle: ""

schedule:
  hour: 18
  minute: 0
  # Chinese holidays and make-up workdays come from the chinesecalendar library.
  # Use the lists below only to override specific dates (YYYY-MM-DD).
  holidays: []
  workdays: []

members:
  # Every identity below is matched case-insensitively; any hit attributes the
  # work to this member. A commit matches on `author` (GitHub login, falling back
  # to the git author name) or `author_email`; a task on its assignee name; a
  # message on the sender's open_id.
  #
  # github_login / lark_user_id / email are the primary identities.
  # git_emails: raw `git config user.email` values. Needed because GitHub returns
  #   `author: null` for commits whose email is not linked to an account, leaving
  #   only the free-form git author name to match on.
  # aliases: extra names (English name, former name, task display name…).
  - github_login: "github-user-1"
    lark_user_id: "ou_example_user_1"
    name: "成员一"
    email: "member1@example.com"
    git_emails: ["member1@example.com"]
    aliases: ["Member One"]
  - github_login: "github-user-2"
    lark_user_id: "ou_example_user_2"
    name: "成员二"
    email: "member2@example.com"
    git_emails: []
    aliases: []

github:
  token_env: "GITHUB_TOKEN"
  repositories:
    - owner: "example-org"
      name: "example-repository"

lark:
  app_id_env: "LARK_APP_ID"
  app_secret_env: "LARK_APP_SECRET"
  # Optional: restrict collected tasks to one Lark tasklist. Leave empty to
  # collect every tasklist visible to the app.
  tasklist_id: "example-tasklist-guid"
  chat_id: "oc_example_chat_id"
  webhook_url_env: "LARK_WEBHOOK_URL"
  keywords:
    - "项目"
    - "需求"
    - "风险"
  excluded_keywords:
    - "薪资"
    - "绩效"

smtp:
  host_env: "SMTP_HOST"
  port_env: "SMTP_PORT"
  username_env: "SMTP_USERNAME"
  password_env: "SMTP_PASSWORD"
  from_env: "SMTP_FROM"
  recipients:
    - "leader@example.com"

storage:
  sqlite_path: "data/reports.db"
  # Markdown/HTML copies of each report are written here as <date>.md / <date>.html
  reports_dir: "reports"
